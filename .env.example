# ==============================================================================
# PrivaVend Environment Configuration
# Autonomous AI Data Vending Machine (DVM) with Cashu Settlement & Nostr NIP-90
# ==============================================================================

# --- Nostr Protocol Settings ---
# 32-byte hex-encoded private key (Leave blank to generate an ephemeral key on startup)
NOSTR_PRIVATE_KEY=
# Comma-separated list of Nostr WebSocket relays
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
# Subscription feed: set to true to process only jobs tagged specifically to this worker pubkey,
# or false to process open unaddressed Kind 5000 requests as well.
REQUIRE_TARGETED_PUBKEY=false

# --- Cashu Ecash Settlement Settings ---
# Default Cashu Mint URL for verification and redemption/swap
CASHU_MINT_URL=https://mint.minibits.cash/Bitcoin
# Minimum required satoshis per job request
CASHU_MIN_FEE_SATS=1
# Atomically swap incoming tokens for fresh worker tokens to prevent double-spends
CASHU_AUTO_SWAP=true
# Allow mock/offline test tokens when mint is unreachable (set false for production!)
CASHU_ALLOW_MOCK_FALLBACK=false

# --- AI Inference Settings ---
# Backend engine: "ollama", "openai_compatible", or "mock"
AI_BACKEND=ollama
# Model identifier
AI_MODEL=llama3
# Ollama base endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional external LLM API settings (used if AI_BACKEND=openai_compatible or as fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.together.xyz/v1

# --- Security & Safety Limits ---
# Maximum allowed prompt length in characters
MAX_PROMPT_CHARS=8192
# Inference timeout in seconds
INFERENCE_TIMEOUT_SECS=60
# Number of concurrent job tasks allowed
MAX_CONCURRENT_JOBS=10
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
